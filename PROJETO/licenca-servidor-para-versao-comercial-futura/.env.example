# Copie este arquivo para ".env" e preencha com valores reais antes de
# iniciar o servidor. NUNCA versione o arquivo ".env" real em Git.

# Chave secreta usada para assinar os tokens de licença (HMAC-SHA256).
# Gere uma com: openssl rand -hex 32
LICENSE_SECRET=troque_esta_chave_por_uma_aleatoria_de_32_bytes

# Senha usada pelos endpoints /admin/* (emitir/consultar/revogar licenças).
# Gere uma com: openssl rand -hex 24
ADMIN_SECRET=troque_esta_senha_administrativa

PORT=3001
