{
  "name": "LeuCloud",
  "short_name": "LeuCloud",
  "description": "Armazenamento em nuvem da LeuName Softwares — seus arquivos com você em qualquer lugar.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#122019",
  "theme_color": "#122019",
  "orientation": "any",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        { "name": "arquivos", "accept": ["image/*", "video/*", "application/pdf", "*/*"] }
      ]
    }
  }
}
