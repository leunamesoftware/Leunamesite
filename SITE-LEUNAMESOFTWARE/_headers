# Garantiza que el sitio siempre cargue la versión más nueva después de un
# deploy, sin que el cliente (o nosotros) necesite borrar el historial/cache
# del navegador. HTML, CSS y JS cambian seguido mientras el sitio está en
# desarrollo activo, así que siempre revalidan (rápido, es solo un
# roundtrip condicional) en vez de confiar en un cache viejo.
/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/painel/
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.json
  Cache-Control: no-cache

# Segurança: só HTTPS (HSTS) e proteções básicas
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://*.leuname.com
  Permissions-Policy: camera=(), microphone=(), geolocation=()
