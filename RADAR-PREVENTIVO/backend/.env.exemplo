# Copie para .env e ajuste. Nunca envie o .env para o GitHub.
PORTA=8787
CAMINHO_BANCO=./dados/radar.db
PASTA_ANEXOS=./dados/anexos
# Segredo misturado às senhas (mínimo 16 caracteres). Obrigatório em produção.
PIMENTA_SENHA=
# Endereços do frontend que podem chamar a API (separados por vírgula).
ORIGENS_PERMITIDAS=http://localhost:5173
FUSO_HORARIO=America/Sao_Paulo
# Hora local em que a rotina diária de análise roda.
HORA_ROTINA=6
# Opcional: permite um agendador externo disparar a rotina (POST /api/rotina/executar).
TOKEN_ROTINA=
DIAS_SESSAO=30
