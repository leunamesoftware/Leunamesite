{
  "name": "razluno-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Razluno API",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings tsx watch src/server.ts",
    "start": "NODE_OPTIONS=--no-warnings tsx src/server.ts",
    "migrate": "NODE_OPTIONS=--no-warnings tsx src/db/migrate-cli.ts",
    "test": "NODE_OPTIONS=--no-warnings vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
