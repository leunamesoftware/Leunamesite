# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8788
DB_PATH=./data/razluno.db
ALLOWED_ORIGINS=http://localhost:5174
PUBLIC_URL=http://localhost:5174
SESSION_DAYS=30
# Required in production (16+ chars each), set with `wrangler secret put`:
PASSWORD_PEPPER=
IP_HASH_SECRET=
# Optional — each feature only turns on when configured:
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
EMAIL_PROVIDER=
