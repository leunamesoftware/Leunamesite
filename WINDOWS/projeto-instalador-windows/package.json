{
  "name": "leuname-gestao-desktop",
  "productName": "LeuName Gestão",
  "version": "1.0.0",
  "description": "LeuName Gestão — sistema de gestão para lojas de celulares e assistência técnica (LeuName Softwares)",
  "author": "LeuName Softwares",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.leunamesoftwares.gestao",
    "productName": "LeuName Gestão",
    "copyright": "Copyright © LeuName Softwares",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Instalar-LeuName-Gestao-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LeuName Gestão",
      "artifactName": "Instalar-LeuName-Gestao-${version}.${ext}"
    }
  }
}
